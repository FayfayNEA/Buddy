VITE_API_URL=http://localhost:8000
VITE_CONTACT_EMAIL=your@email.com

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
# Must match GOOGLE_CLIENT_ID on the backend — same client ID both sides.
# Add your frontend origin(s) (e.g. https://www.meetbuddy.xyz, http://localhost:5173) under
# "Authorized JavaScript origins" on that client. Leave blank to hide the Google button.
VITE_GOOGLE_CLIENT_ID=

# Optional analytics — leave blank to disable. Both are no-ops locally unless set.
# Google Analytics 4 Measurement ID (Admin > Data Streams > your stream > Measurement ID)
VITE_GA_MEASUREMENT_ID=
# Hotjar Site ID (Settings > Sites & Organization > your site)
VITE_HOTJAR_SITE_ID=
