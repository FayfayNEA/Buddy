OPENAI_API_KEY=your_openai_api_key_here
FAL_KEY=your_fal_api_key_here
FAL_IMAGE_MODEL=fal-ai/flux/schnell

# Frontend origins allowed to call this API. Use * for any origin (credentials off),
# or a comma-separated list. meetbuddy.xyz is always included so domain moves don't break CORS.
# Example: ALLOWED_ORIGINS=https://www.meetbuddy.xyz,https://meetbuddy.xyz,http://localhost:5173
ALLOWED_ORIGINS=*

# Secret required in X-Debug-Secret header to access /debug/* endpoints
# If unset, debug endpoints return 404. Set to any strong random string.
DEBUG_SECRET=

# Total generations allowed per demo visitor (image + mockup + video combined)
DEMO_LIMIT=5
# Video generations allowed per demo visitor, on top of / within the general limit above
VIDEO_DEMO_LIMIT=1
# Comma-separated IPs that never hit the demo gate (always reads back as "0 used").
# Defaults to loopback so local dev/testing is never demo-limited. Add your own IP here
# if testing against a deployed backend directly (not through the normal frontend flow).
DEMO_UNLIMITED_IPS=127.0.0.1,::1,localhost

# ── Accounts (login + saved work) ──
# Postgres connection string for user accounts + saved sessions (e.g. from Supabase:
# Project Settings > Database > Connection string > URI). Left unset, falls back to a
# local SQLite file (./buddy.db) — fine for dev, but Cloud Run's disk does not persist
# across redeploys/instances, so production MUST set this to a real Postgres URL.
DATABASE_URL=

# Random long string used to sign login sessions (JWTs). Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Free-tier caps for a signed-in account (anonymous visitors use DEMO_LIMIT above).
# Paying subscribers bypass both.
ACCOUNT_LIMIT=50
ACCOUNT_VIDEO_LIMIT=2

# ── Stripe billing ($10/mo unlimited) ──
# Leave STRIPE_SECRET_KEY blank to run without billing — the upgrade UI hides itself.
# Dashboard > Developers > API keys (use sk_test_... while testing)
STRIPE_SECRET_KEY=
# Dashboard > Product catalogue > your $10/mo recurring price > price ID (price_...)
STRIPE_PRICE_ID=
# Dashboard > Developers > Webhooks > your endpoint > signing secret (whsec_...)
# Point the endpoint at https://<your-backend>/billing/webhook and subscribe to:
#   checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Shown on the upgrade button
STRIPE_PRICE_DISPLAY=$10/month
# Where Stripe sends users back to after checkout (your frontend origin)
APP_BASE_URL=http://localhost:5173

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
# Must match VITE_GOOGLE_CLIENT_ID on the frontend — same client ID both sides.
# Add your frontend origin(s) under "Authorized JavaScript origins" on that client.
GOOGLE_CLIENT_ID=
