OPENAI_API_KEY=your_openai_api_key_here
FAL_KEY=your_fal_api_key_here
FAL_IMAGE_MODEL=fal-ai/flux/schnell

# Comma-separated list of allowed frontend origins, or * to allow all
# Example: ALLOWED_ORIGINS=https://yourportfolio.com,https://www.yourportfolio.com
ALLOWED_ORIGINS=*

# Secret required in X-Debug-Secret header to access /debug/* endpoints
# If unset, debug endpoints return 404. Set to any strong random string.
DEBUG_SECRET=

# Total generations allowed per demo visitor (image + mockup + video combined)
DEMO_LIMIT=4
# Video generations allowed per demo visitor, on top of / within the general limit above
VIDEO_DEMO_LIMIT=1
# Comma-separated IPs that never hit the demo gate (always reads back as "0 used").
# Defaults to loopback so local dev/testing is never demo-limited. Add your own IP here
# if testing against a deployed backend directly (not through the normal frontend flow).
DEMO_UNLIMITED_IPS=127.0.0.1,::1,localhost
